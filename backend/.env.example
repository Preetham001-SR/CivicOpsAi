# Database
POSTGRES_DB=civicops
POSTGRES_USER=civicops
POSTGRES_PASSWORD=civicops
DATABASE_URL=postgresql+asyncpg://civicops:civicops@localhost:5432/civicops

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=civicops
MINIO_SECURE=false

# NVIDIA (Nemotron/Llama via NVIDIA AI Endpoints)
NVIDIA_API_KEY=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

# Langfuse (Observability)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=civicops-api

# App Settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# Confidence Thresholds
CONFIDENCE_THRESHOLD_AUTO=0.9
CONFIDENCE_THRESHOLD_REVIEW=0.7

# Model Settings
WHISPER_MODEL=base
VISION_MODEL=google/vit-base-patch16-224
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# External APIs (optional)
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=